# Application endpoints
BASE_URL=https://demowebshop.tricentis.com
API_BASE_URL=https://your-api.example.com
HEADLESS=true
# Execution artifacts. If omitted, defaults are shown below.
# screenshot = off | on | only-on-failure (default: only-on-failure)
# video/trace = off | on | retain-on-failure (default: off)
SCREENSHOT=only-on-failure
VIDEO=off
TRACE=off
# Number of isolated Cucumber workers. Use 1 for local debugging; use 2-4 in CI.
PARALLEL_WORKERS=1

# Named test roles. Never commit real values.
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_BEARER_TOKEN=
ADMIN_API_KEY=
MEMBER_USERNAME=member@example.com
MEMBER_PASSWORD=change-me
MEMBER_BEARER_TOKEN=
